  "$id": "https://cyberagent.local/schemas/plugins/ffuf-low-rate.output.schema.json",
  "title": "ffuf-low-rate output",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
